<Page x:Class="WpBlueBubbles.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:WpBlueBubbles" Background="{StaticResource AppBackgroundBrush}">
  <Page.Resources>
    <Style x:Key="AccentButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource MessengerBlueBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="18,0"/>
    </Style>
    <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="18"/><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="NavigationButtonStyle" TargetType="Button">
      <Setter Property="FontSize" Value="18"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="MinHeight" Value="50"/><Setter Property="Padding" Value="8,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="ComposerTextBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="PlaceholderForeground" Value="#A9B6BE"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <DataTemplate x:Key="LargeChatTemplate">
      <Grid Padding="16,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Width="44" Height="44" VerticalAlignment="Center"><Border CornerRadius="22" Background="{StaticResource MessengerBlueBrush}"><Grid><Image Source="{Binding AvatarSource}" Stretch="UniformToFill" Visibility="{Binding HasAvatar, Converter={StaticResource BooleanToVisibilityConverter}}" ImageFailed="ChatAvatar_Failed"/><TextBlock Text="{Binding Initials}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowInitials, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid></Border><Ellipse Width="11" Height="11" Fill="{StaticResource MessengerBlueBrush}" Stroke="{StaticResource HeaderBackgroundBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsUnread, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid>
        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="{Binding TitleWeight}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Preview}" Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/><TextBlock Text="{Binding ParticipantSummary}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="{Binding IsGroupChat, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="6,4,0,0"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LargeMessageTemplate">
      <StackPanel HorizontalAlignment="{Binding BubbleAlignment}" MaxWidth="520" Margin="0,4">
        <TextBlock Text="{Binding SenderName}" Visibility="{Binding ShowSenderName, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="4,0,4,3" TextTrimming="CharacterEllipsis"/>
        <Border Background="{Binding BubbleBrush}" CornerRadius="6" Padding="12,8"><StackPanel><Image Source="{Binding AttachmentUri}" Visibility="{Binding IsImageAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" MaxWidth="300" MaxHeight="260" Stretch="Uniform" ImageOpened="Media_Opened" Holding="Media_Holding" RightTapped="Media_RightTapped" Tapped="Image_Tapped"/><Grid Holding="Media_Holding" RightTapped="Media_RightTapped"><MediaElement Source="{Binding AttachmentUri}" Visibility="{Binding IsVideoAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" AreTransportControlsEnabled="True" AutoPlay="False" MaxWidth="300" MaxHeight="260" MediaOpened="Media_Opened" MediaFailed="AttachmentMedia_Failed"/></Grid><RichTextBlock IsTextSelectionEnabled="False" Visibility="{Binding HasText, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="16" TextWrapping="Wrap" Holding="Message_Holding" RightTapped="Message_RightTapped" Loaded="MessageText_Loaded" DataContextChanged="MessageText_DataContextChanged" Margin="0,5,0,0"/><TextBlock Text="{Binding AttachmentLabel}" Visibility="{Binding HasNonPreviewAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="White" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
        <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,2,0"/>
      </StackPanel>
    </DataTemplate>
  </Page.Resources>
  <Grid x:Name="RootGrid" Background="{StaticResource AppBackgroundBrush}">
    <SplitView x:Name="NavigationSplitView" DisplayMode="Overlay" OpenPaneLength="250" CompactPaneLength="0" PaneBackground="{StaticResource MessengerBlueBrush}">
      <SplitView.Pane>
        <Grid x:Name="NavigationPaneGrid" Padding="14,20,12,14">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Border x:Name="NavigationAvatar" Width="42" Height="42" CornerRadius="21" Background="#18000000">
              <FontIcon Glyph="&#xE77B;" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="NavigationIdentityText" Text="LiveBubbles" FontSize="21" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,32,0,0">
            <Button x:Name="NavChatsButton" Style="{StaticResource NavigationButtonStyle}" Click="Chats_Click"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE8F2;"/><TextBlock Text="Chats" Margin="22,0,0,0"/></StackPanel></Button>
            <Button x:Name="NavArchivedButton" Style="{StaticResource NavigationButtonStyle}" Click="Archived_Click"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE7B8;"/><TextBlock Text="Archived" Margin="22,0,0,0"/></StackPanel></Button>
            <Button x:Name="NavContactsButton" Style="{StaticResource NavigationButtonStyle}" Click="Contacts_Click"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE716;"/><TextBlock Text="Contacts" Margin="22,0,0,0"/></StackPanel></Button>
          </StackPanel>
          <Button x:Name="NavSettingsButton" Grid.Row="3" Style="{StaticResource NavigationButtonStyle}" Click="Settings_Click"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE713;"/><TextBlock Text="Settings" Margin="22,0,0,0"/></StackPanel></Button>
        </Grid>
      </SplitView.Pane>

      <SplitView.Content>
        <Grid>
          <Grid.RowDefinitions><RowDefinition x:Name="PrimaryHeaderRow" Height="54"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid x:Name="PrimaryHeader" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Canvas.ZIndex="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="HeaderLeadingColumn" Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="MenuButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE700;" Click="Menu_Click" AutomationProperties.Name="Menu"/>
            <Button x:Name="BackButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE72B;" Click="Back_Click" Visibility="Collapsed" AutomationProperties.Name="Back to chats"/>
            <TextBlock x:Name="PageTitle" Grid.Column="1" Text="Chats" FontSize="22" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="ChatActionsButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE10C;" Click="ChatActions_Click" Visibility="Collapsed" AutomationProperties.Name="Conversation actions"/>
              <Button x:Name="SearchButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE721;" Click="Search_Click" AutomationProperties.Name="Search chats"/>
              <Button x:Name="ComposeButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE70F;" Click="Compose_Click" AutomationProperties.Name="Compose new message"/>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ChatColumn" Width="*"/><ColumnDefinition x:Name="DividerColumn" Width="0"/><ColumnDefinition x:Name="ConversationColumn" Width="0"/></Grid.ColumnDefinitions>
            <ProgressBar x:Name="InitialLoadingProgress" Grid.ColumnSpan="3" Height="5" Margin="0,-2,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" IsIndeterminate="False" Foreground="{StaticResource MessengerBlueBrush}" Background="Transparent" Visibility="Collapsed" Canvas.ZIndex="20"/>

            <Grid x:Name="ChatsPane" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource PanelBackgroundBrush}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBox x:Name="SearchBox" Margin="12,8" PlaceholderText="Search chats" TextChanged="SearchBox_TextChanged" Visibility="Collapsed"/>
              <ListView x:Name="ChatsList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="ChatsList_ItemClick" SelectionMode="Single">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="68"/></Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Grid Padding="12,7">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Grid Width="38" Height="38" VerticalAlignment="Center"><Border CornerRadius="19" Background="{StaticResource MessengerBlueBrush}"><Grid><Image Source="{Binding AvatarSource}" Stretch="UniformToFill" Visibility="{Binding HasAvatar, Converter={StaticResource BooleanToVisibilityConverter}}" ImageFailed="ChatAvatar_Failed"/><TextBlock Text="{Binding Initials}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowInitials, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid></Border><Ellipse Width="9" Height="9" Fill="{StaticResource MessengerBlueBrush}" Stroke="{StaticResource HeaderBackgroundBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsUnread, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid>
                      <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="{Binding TitleWeight}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Preview}" Foreground="{StaticResource MutedTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ParticipantSummary}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Visibility="{Binding IsGroupChat, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="5,3,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource AppBorderBrush}"/>

            <Grid x:Name="ConversationPane" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource AppBackgroundBrush}">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid x:Name="EmptyConversation">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <FontIcon Glyph="&#xE8F2;" FontSize="42" Foreground="{StaticResource MutedTextBrush}"/>
                  <TextBlock Text="Choose a conversation" Foreground="{StaticResource MutedTextBrush}" FontSize="20" Margin="0,12,0,0"/>
                </StackPanel>
              </Grid>
              <ListView x:Name="MessagesList" Visibility="Collapsed" Padding="10,7" SelectionMode="None">
                <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <StackPanel HorizontalAlignment="{Binding BubbleAlignment}" MaxWidth="460" Margin="0,2">
                      <TextBlock Text="{Binding SenderName}" Visibility="{Binding ShowSenderName, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="4,0,4,3" TextTrimming="CharacterEllipsis"/>
                      <Border Background="{Binding BubbleBrush}" CornerRadius="5" Padding="10,6"><StackPanel><Image Source="{Binding AttachmentUri}" Visibility="{Binding IsImageAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" MaxWidth="270" MaxHeight="230" Stretch="Uniform" ImageOpened="Media_Opened" Holding="Media_Holding" RightTapped="Media_RightTapped" Tapped="Image_Tapped"/><Grid Holding="Media_Holding" RightTapped="Media_RightTapped"><MediaElement Source="{Binding AttachmentUri}" Visibility="{Binding IsVideoAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" AreTransportControlsEnabled="True" AutoPlay="False" MaxWidth="270" MaxHeight="230" MediaOpened="Media_Opened" MediaFailed="AttachmentMedia_Failed"/></Grid><RichTextBlock IsTextSelectionEnabled="False" Visibility="{Binding HasText, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="15" TextWrapping="Wrap" Holding="Message_Holding" RightTapped="Message_RightTapped" Loaded="MessageText_Loaded" DataContextChanged="MessageText_DataContextChanged" Margin="0,4,0,0"/><TextBlock Text="{Binding AttachmentLabel}" Visibility="{Binding HasNonPreviewAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="White" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
                      <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,2,0"/>
                    </StackPanel>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <Grid x:Name="Composer" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource HeaderBackgroundBrush}" Padding="3,4" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="ComposerAttachColumn" Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ComposerSendColumn" Width="42"/></Grid.ColumnDefinitions>
                <Grid x:Name="AttachmentBannerHost" Grid.ColumnSpan="3" Visibility="Collapsed">
                  <TextBlock x:Name="SharedAttachmentBanner" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="8,0,40,4"/>
                  <Button x:Name="ClearAttachmentButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE711;" Width="32" Height="32" FontSize="14" Click="ClearAttachment_Click" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Remove queued attachment"/>
                </Grid>
                <Button x:Name="AttachButton" Grid.Row="1" Style="{StaticResource HeaderIconButtonStyle}" Width="42" Height="42" Content="&#xE723;" Click="Attach_Click" AutomationProperties.Name="Attach a file"/>
                <TextBox x:Name="MessageBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource ComposerTextBoxStyle}" PlaceholderText="Type a message" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="104" Padding="5,5" FontSize="16" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="MessageBox_TextChanged" KeyDown="MessageBox_KeyDown"><TextBox.Resources><SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/><SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/><SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/><SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/><SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/><SolidColorBrush x:Key="TextControlForeground" Color="White"/><SolidColorBrush x:Key="TextControlForegroundFocused" Color="White"/></TextBox.Resources></TextBox>
                <Button x:Name="SendButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource HeaderIconButtonStyle}" Width="42" Height="42" Content="&#xE724;" Click="Send_Click" AutomationProperties.Name="Send message"/>
              </Grid>
            </Grid>
          </Grid>

          <Border x:Name="StatusBar" Grid.Row="2" Background="#B21B2830" Padding="12,7" Visibility="Collapsed"><TextBlock x:Name="StatusText" FontSize="14" TextWrapping="Wrap"/></Border>
        </Grid>
      </SplitView.Content>
    </SplitView>

    <Grid x:Name="SettingsOverlay" Background="{StaticResource AppBackgroundBrush}" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition x:Name="SettingsHeaderRow" Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="SettingsHeader" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsHeaderLeadingColumn" Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="SettingsBackButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE72B;" Click="CloseSettings_Click" AutomationProperties.Name="Close settings"/>
        <TextBlock x:Name="SettingsHeaderTitle" Grid.Column="1" Text="Settings" FontSize="25" VerticalAlignment="Center"/>
      </Grid>
      <ScrollViewer Grid.Row="1">
        <StackPanel MaxWidth="560" Padding="28,36" HorizontalAlignment="Center">
          <StackPanel x:Name="SetupOnlyPanel">
          <TextBlock Text="Connect to BlueBubbles" FontSize="28" TextWrapping="Wrap" Margin="0,14,0,4"/>
          <TextBlock Text="Use the server's setup QR code or enter its address and password." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Manual setup" Click="ManualSetup_Click"/>
            <Button Content="Use QR setup code" Click="QrSetup_Click" Margin="8,0,0,0"/>
          </StackPanel>
          <StackPanel x:Name="ManualSetupPanel">
            <TextBox x:Name="ServerAddressBox" Header="Server address" PlaceholderText="http://192.168.1.20:1234" InputScope="Url"/>
            <PasswordBox x:Name="ServerPasswordBox" Header="Server password" PlaceholderText="Password" Margin="0,14,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Style="{StaticResource AccentButtonStyle}"/>
              <ProgressRing x:Name="ConnectProgress" Width="28" Height="28" IsActive="False" Margin="10,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="QrSetupPanel" Visibility="Collapsed">
            <TextBlock Text="Scan the setup QR code shown by your BlueBubbles server." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <Button Content="Scan setup QR code with camera" Click="ScanQr_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
          </StackPanel>
          </StackPanel>
          <StackPanel x:Name="ConnectedSettingsPanel" Visibility="Collapsed">
            <TextBlock Text="Sync messages" FontSize="22"/>
            <TextBlock x:Name="SyncDescription" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <Slider x:Name="MessagesPerChatSlider" Minimum="1" Maximum="50" StepFrequency="1" ValueChanged="MessagesPerChatSlider_ValueChanged" Margin="0,10,0,0"/>
            <ComboBox x:Name="SyncTimeframeBox" Header="Time range" SelectionChanged="SyncTimeframeBox_SelectionChanged" Margin="0,10,0,0"><ComboBoxItem Tag="7" Content="Last 7 days"/><ComboBoxItem Tag="30" Content="Last 30 days"/><ComboBoxItem Tag="365" Content="Last year"/><ComboBoxItem Tag="0" Content="All time"/></ComboBox>
            <ComboBox x:Name="PollIntervalBox" Header="Message fetch frequency" SelectionChanged="PollIntervalBox_SelectionChanged" Margin="0,10,0,0"><ComboBoxItem Tag="3" Content="Every 3 seconds"/><ComboBoxItem Tag="5" Content="Every 5 seconds"/><ComboBoxItem Tag="10" Content="Every 10 seconds"/><ComboBoxItem Tag="15" Content="Every 15 seconds"/><ComboBoxItem Tag="30" Content="Every 30 seconds"/></ComboBox>
            <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,26,0,22"/>
            <TextBlock Text="Notifications" FontSize="22"/>
            <ToggleSwitch x:Name="NotificationsToggle" Header="Message notifications" OffContent="Off" OnContent="On" Toggled="NotificationsToggle_Toggled" Margin="0,12,0,0"/>
            <ToggleSwitch x:Name="NotificationPreviewsToggle" Header="Show names and message previews" OffContent="Private" OnContent="Show previews" Toggled="NotificationPreviewsToggle_Toggled" Margin="0,12,0,0"/>
            <TextBlock x:Name="NotificationsStatusText" Text="Notifications connect automatically after sign-in." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <TextBlock Text="Uses your existing BlueBubbles connection. Windows may delay background delivery while saving battery or offline." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Button Content="Test notification" Click="TestNotification_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            <HyperlinkButton Content="Reconnect notifications" Click="RetryNotifications_Click" HorizontalAlignment="Left" Padding="0" Margin="0,10,0,0"/>

            <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,26,0,22"/>
            <TextBlock Text="Theme" FontSize="22"/>
            <ComboBox x:Name="ThemeModeBox" Header="App theme" SelectionChanged="ThemeModeBox_SelectionChanged" Margin="0,12,0,0"><ComboBoxItem Tag="System" Content="System"/><ComboBoxItem Tag="Light" Content="Light"/><ComboBoxItem Tag="Blue" Content="Blue"/><ComboBoxItem Tag="Dark" Content="Dark"/></ComboBox>
            <ToggleSwitch x:Name="AccentColorToggle" Header="Use accent color" OffContent="Messenger blue" OnContent="Windows accent" Toggled="ThemeToggle_Toggled" Margin="0,12,0,0"/>
            <ToggleSwitch x:Name="LargerUiToggle" Header="Larger UI" OffContent="Compact" OnContent="Large" Toggled="ThemeToggle_Toggled" Margin="0,12,0,0"/>

            <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,26,0,22"/>
            <TextBlock Text="Server details" FontSize="22"/>
            <TextBlock Text="Server" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0"/>
            <TextBlock x:Name="ServerDetailsText" Text="Unavailable" TextWrapping="Wrap"/>
            <TextBlock Text="Private API" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0"/>
            <TextBlock x:Name="PrivateApiStatusText" Text="Status unavailable" TextWrapping="Wrap"/>
            <HyperlinkButton x:Name="PrivateApiRefreshButton" Content="Refresh status" Click="PrivateApiRefresh_Click" HorizontalAlignment="Left" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
            <ToggleSwitch x:Name="SendReadReceiptsToggle" Header="Send read receipts" OffContent="Off" OnContent="On" Toggled="SendReadReceiptsToggle_Toggled" Margin="0,14,0,0"/>
            <ToggleSwitch x:Name="SendTypingIndicatorsToggle" Header="Send typing indicators" OffContent="Off" OnContent="On" Toggled="SendTypingIndicatorsToggle_Toggled" Margin="0,10,0,0"/>
            <ToggleSwitch x:Name="DeveloperModeToggle" Header="Developer mode" OffContent="Off" OnContent="On" Toggled="DeveloperModeToggle_Toggled" Margin="0,10,0,0"/>

            <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,26,0,22"/>
            <TextBlock Text="Sign out and reset app" FontSize="22"/>
            <TextBlock Text="Remove this device's connection and local state. Messages will not be deleted from the server." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
            <Button Content="Sign out and reset app" Click="SignOut_Click" HorizontalAlignment="Left"/>

            <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,26,0,22"/>
            <TextBlock Text="Credits" FontSize="22"/>
            <TextBlock Margin="0,8,0,0"><Run Text="developed by "/><Hyperlink NavigateUri="https://github.com/RetiredLake/LiveBubbles"><Run Text="retiredlake"/></Hyperlink></TextBlock>
            <TextBlock x:Name="PackageVersionText" Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="CheckForUpdateButton" Content="Check for Update" Click="CheckForUpdate_Click"/><ProgressRing x:Name="UpdateProgressRing" Width="24" Height="24" Margin="12,0,0,0" IsActive="False" Visibility="Collapsed"/></StackPanel>
            <TextBlock x:Name="UpdateStatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
          <TextBlock x:Name="ConnectError" Foreground="#FFFF8C82" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid x:Name="QrScannerOverlay" Background="#F2071117" Visibility="Collapsed">
      <Grid Padding="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <CaptureElement x:Name="QrCameraPreview" Stretch="Uniform"/>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,0"><TextBlock x:Name="QrScannerStatus" Text="Point the camera at the BlueBubbles setup QR code" TextWrapping="Wrap" FontSize="17" TextAlignment="Center"/><ProgressRing x:Name="QrConnectProgress" Width="32" Height="32" IsActive="False" Margin="0,12,0,0"/><Button Content="Cancel camera scan" Click="CancelQrScan_Click" Margin="0,10,0,0"/></StackPanel>
      </Grid>
    </Grid>

    <Grid x:Name="ComposeOverlay" Background="{StaticResource AppBackgroundBrush}" Visibility="Collapsed">
      <Grid>
        <Grid.RowDefinitions><RowDefinition x:Name="ComposeHeaderRow" Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ComposeHeaderLeadingColumn" Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ComposeBackButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE72B;" Click="CloseCompose_Click" AutomationProperties.Name="Back"/><TextBlock x:Name="ComposeHeaderTitle" Grid.Column="1" Text="New message" FontSize="25" VerticalAlignment="Center"/></Grid>
        <Grid Grid.Row="1" MaxWidth="720" HorizontalAlignment="Stretch" Margin="18,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBox x:Name="RecipientBox" Header="To" PlaceholderText="Phone numbers or emails, separated by commas" TextChanged="RecipientBox_TextChanged"/>
          <StackPanel Grid.Row="1"><Button Content="Choose contact" Click="ChooseContact_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/><TextBlock x:Name="ComposeHint" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" Text="Enter one or more phone numbers or email addresses, then write a message."/><TextBlock x:Name="SharedComposePreview" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/></StackPanel>
          <ListView x:Name="RecipientMatchesList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="RecipientMatchesList_ItemClick" SelectionMode="None" Margin="0,12,0,0"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" FontSize="18" Padding="8" TextTrimming="CharacterEllipsis"/></DataTemplate></ListView.ItemTemplate></ListView>
        </Grid>
        <Grid Grid.Row="2" Background="{StaticResource HeaderBackgroundBrush}" Padding="4,6" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBox x:Name="ComposeMessageBox" Style="{StaticResource ComposerTextBoxStyle}" PlaceholderText="Type a message" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="124" Padding="12,7" FontSize="18" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="ComposeMessageBox_TextChanged" KeyDown="ComposeMessageBox_KeyDown"><TextBox.Resources><SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/><SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/><SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/><SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/><SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/><SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/><SolidColorBrush x:Key="TextControlForeground" Color="White"/><SolidColorBrush x:Key="TextControlForegroundFocused" Color="White"/></TextBox.Resources></TextBox><Button x:Name="ComposeSendButton" Grid.Column="1" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE724;" Click="ComposeSend_Click" AutomationProperties.Name="Send new message"/></Grid>
      </Grid>
    </Grid>

    <Grid x:Name="ContactsOverlay" Background="{StaticResource AppBackgroundBrush}" Visibility="Collapsed">
      <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition x:Name="ContactsHeaderRow" Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ContactsHeaderLeadingColumn" Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ContactsBackButton" Style="{StaticResource HeaderIconButtonStyle}" Content="&#xE72B;" Click="CloseContacts_Click" AutomationProperties.Name="Back"/><TextBlock x:Name="ContactsHeaderTitle" Grid.Column="1" Text="Contacts" FontSize="25" VerticalAlignment="Center"/></Grid>
        <StackPanel Grid.Row="1" Padding="18,16,18,4">
          <TextBlock Text="Choose a phone number or email address to start composing." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
          <TextBox x:Name="ContactsSearchBox" PlaceholderText="Search contacts" TextChanged="ContactsSearchBox_TextChanged" Margin="0,14,0,4"/>
        </StackPanel>
        <ListView x:Name="ContactsList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="ContactsList_ItemClick" SelectionMode="None" Padding="18,0">
          <ListView.ItemTemplate><DataTemplate><Grid Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource MessengerBlueBrush}" VerticalAlignment="Center"><Grid><Image Source="{Binding AvatarSource}" Stretch="UniformToFill" Visibility="{Binding HasAvatar, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowInitials, Converter={StaticResource BooleanToVisibilityConverter}}"/></Grid></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Address}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Kind}" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>

    <Grid x:Name="ImageViewerOverlay" Background="Black" Visibility="Collapsed" Tapped="CloseImageViewer_Tapped" Canvas.ZIndex="20">
      <Image x:Name="ImageViewerImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>

  </Grid>

</Page>
